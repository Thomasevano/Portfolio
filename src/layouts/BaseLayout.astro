---
import { ClientRouter } from "astro:transitions";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/700.css";
import "../styles/reset.css";
import "../styles/main.css";
import socialPreview from "../assets/memoji.jpeg";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import Navbar from "../components/Navbar.astro";
import { getLangFromUrl, localizePath, useTranslations } from "../i18n/utils";

type OpenGraphType = "website" | "article";

interface Props {
  pageTitle: string;
  description?: string;
  noIndex?: boolean;
  ogType?: OpenGraphType;
  publishedTime?: Date;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  pageTitle,
  description = t("meta.home-description"),
  noIndex = false,
  ogType = "website",
  publishedTime,
} = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, site);
const socialImageURL = new URL(socialPreview.src, site);
const ogLocale = lang === "fr" ? "fr_FR" : "en_GB";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {
      import.meta.env.PLAUSIBLE_URL && (
        <script
          defer
          is:inline
          data-domain="thomasevano.fr"
          src={import.meta.env.PLAUSIBLE_URL}
        />
      )
    }
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#fcfcfc" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Thomas Evano | Blog"
      href={new URL(localizePath("/rss.xml", lang), site)}
    />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Thomas Evano" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="Thomas Evano" />
    <meta property="og:image:width" content={String(socialPreview.width)} />
    <meta property="og:image:height" content={String(socialPreview.height)} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Thomas Evano" />
    <ClientRouter />
  </head>
  <body class="light">
    <a class="skip-link" href="#main-content">{t("a11y.skip-content")}</a>
    <Navbar />
    <main id="main-content" class="app" tabindex="-1">
      <slot />
      <ScrollToTop />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  body {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }
</style>
