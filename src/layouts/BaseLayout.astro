---
import { ClientRouter } from "astro:transitions";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/700.css";
import "../styles/reset.css";
import "../styles/main.css";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import Navbar from "../components/Navbar.astro";
import { getLangFromUrl } from "../i18n/utils";

const image = "../assets/memoji.jpeg";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const lang = getLangFromUrl(Astro.url);
const { pageTitle, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {
      import.meta.env.PLAUSIBLE_URL && (
        <script
          defer
          is:inline
          data-domain="thomasevano.fr"
          src={import.meta.env.PLAUSIBLE_URL}
        />
      )
    }
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <ClientRouter />
    <meta name="robots" content="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.origin} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Thomas Evano | Blog"
      href={new URL("rss.xml", Astro.site)}
    />
  </head>
  <body class="light">
    <Navbar />
    <div id="top" class="app">
      <slot />
      <ScrollToTop />
    </div>
    <Footer lang={lang} />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
</style>
