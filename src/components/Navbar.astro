---
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import ThemeToggle from "./ThemeToggle.astro";
import { Image } from "astro:assets";
import heyMemoji from "../assets/hey.webp";

import { getLangFromUrl, localizePath, useTranslations } from "../i18n/utils";
import { Rss } from "@lucide/astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = (to: string) => localizePath(to, lang);
---

<header class="header">
  <Astronav closeOnClick>
    <div class="icons">
      <Image
        src={heyMemoji}
        style="height: 3rem;width: 3rem;margin-top: -1.25rem;"
        alt="hey waving memoji"
      />
      <MenuIcon class="menu-icon" />
    </div>
    <MenuItems class="hidden menu-items">
      <ul class="menu-items__list">
        <li>
          <a href={path("/")} class="link link--nav">{t("nav.home")}</a>
        </li>
        <li>
          <a href={path("/blog")} class="link link--nav"
            >{t("nav.blog")}</a
          >
        </li>
        <li>
          <a href={path("/#about")} class="link link--nav"
            >{t("nav.about")}</a
          >
        </li>
        <li>
          <a href={path("/#projects")} class="link link--nav"
            >{t("nav.projects")}</a
          >
        </li>
        <li>
          <a href={path("/#skills")} class="link link--nav"
            >{t("nav.skills")}</a
          >
        </li>
      </ul>
      <a href={path("/rss.xml")} class="rss-link link link--nav" aria-label={t("footer.subscribe-rss")}
        ><Rss /></a
      >
      <div class="theme-toggle">
        <ThemeToggle />
      </div>
    </MenuItems>
  </Astronav>
</header>

<style>
  .header {
    display: flex;
    flex-direction: column;
    margin: 1.25rem 0;
    padding: 0 1em;
  }
  .icons {
    display: flex;
    justify-content: space-between;
  }

  .menu-items__list {
    display: flex;
    flex-direction: column;
  }

  .theme-toggle {
    margin: 1rem 0;
  }
  @media (min-width: 1024px) {
    .header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 0;
    }
    .menu-items__list {
      flex-direction: row;
      gap: 0.75rem;
    }
    .theme-toggle {
      display: flex;
      align-items: center;
    }
  }
</style>
