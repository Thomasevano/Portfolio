---
import { Image } from "astro:assets";
import { Menu, Rss } from "@lucide/astro";
import ThemeToggle from "./ThemeToggle.astro";
import heyMemoji from "../assets/hey.webp";
import { getLangFromUrl, localizePath, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = (to: string) => localizePath(to, lang);
---

<header class="header">
  <div class="icons">
    <a href={path("/")} aria-label={t("nav.home-label")}>
      <Image
        src={heyMemoji}
        style="height: 3rem;width: 3rem;margin-top: -1.25rem;"
        alt=""
      />
    </a>
    <button
      class="menu-icon"
      id="menu-toggle"
      type="button"
      aria-controls="menu-items"
      aria-expanded="false"
      aria-label={t("nav.menu")}
    >
      <Menu aria-hidden="true" />
    </button>
  </div>

  <nav class="menu-items" id="menu-items" aria-label={t("nav.label")}>
    <ul class="menu-items__list">
      <li><a href={path("/")} class="link link--nav">{t("nav.home")}</a></li>
      <li><a href={path("/#experience")} class="link link--nav">{t("nav.experience")}</a></li>
      <li><a href={path("/#projects")} class="link link--nav">{t("nav.projects")}</a></li>
      <li><a href={path("/#capabilities")} class="link link--nav">{t("nav.capabilities")}</a></li>
      <li><a href={path("/blog")} class="link link--nav">{t("nav.blog")}</a></li>
    </ul>
    <a
      href={path("/rss.xml")}
      class="rss-link link link--nav"
      aria-label={t("footer.subscribe-rss")}
    >
      <Rss aria-hidden="true" />
    </a>
    <div class="theme-toggle">
      <ThemeToggle label={t("a11y.theme-toggle")} />
    </div>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("menu-items");
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      menu.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.onclick = () => setOpen(toggle.getAttribute("aria-expanded") !== "true");
    menu.onclick = (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    };
  });
</script>

<style>
  .header {
    display: flex;
    flex-direction: column;
    margin: 1.25rem 0;
    padding: 0 1em;
  }

  .icons {
    display: flex;
    justify-content: space-between;
  }

  .menu-icon {
    border: none;
    padding: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .menu-items__list {
    display: flex;
    flex-direction: column;
  }

  .rss-link :global(svg),
  .theme-toggle :global(svg) {
    width: 24px;
    height: 24px;
  }

  .theme-toggle {
    margin: 1rem 0;
  }

  @media (min-width: 1024px) {
    .header {
      flex-direction: row;
      justify-content: space-between;
      padding: 0;
      align-items: center;
    }

    .menu-items__list {
      flex-direction: row;
      gap: 0.75rem;
    }

    .theme-toggle {
      display: flex;
      align-items: center;
    }
  }
</style>
