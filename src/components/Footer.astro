---
import { localizePath, useTranslations } from "../i18n/utils";
import LanguagePicker from "./LanguagePicker.astro";
import { Rss } from "@lucide/astro";

const currentYear = new Date().getFullYear();

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer>
  <LanguagePicker />
  <a href={localizePath("/rss.xml", lang)} class="link footer__link rss-link">
    {t("footer.subscribe-rss")}
    <Rss title="RSS Feed icon" />
  </a>
  <span>🚀 Built by Thomas Evano using Astro with ♥️ &copy; {currentYear}</span>
</footer>
<style>
  footer {
    text-align: center;
    padding-bottom: 1rem;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer__link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--clr-fg);
  }
  .rss-link {
    margin: 1em 0.5em 0;
    display: inline-flex;
    gap: 1em;
  }

  @media (max-width: 600px) {
    footer {
      padding: 2em;
    }
  }
</style>
