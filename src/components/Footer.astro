---
import { Rss } from "@lucide/astro";
import { localizePath, useTranslations } from "../i18n/utils";
import LanguagePicker from "./LanguagePicker.astro";

const currentYear = new Date().getFullYear();
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer>
  <LanguagePicker />
  <a href={localizePath("/rss.xml", lang)} class="link footer__link rss-link">
    {t("footer.subscribe-rss")}
    <Rss aria-hidden="true" />
  </a>
  <span>{t("footer.built")} · © {currentYear}</span>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    padding-bottom: 1rem;
    text-align: center;
    align-items: center;
  }

  .footer__link {
    color: var(--clr-fg);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .rss-link {
    display: inline-flex;
    gap: 1em;
    margin: 1em 0.5em 0;
  }

  .rss-link :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (max-width: 600px) {
    footer {
      padding: 2em;
    }
  }
</style>
