---
import { FileText } from "@lucide/astro";
import BlueSkyIcon from "./BlueskyIcon.astro";
import GithubIcon from "./GithubIcon.astro";
import LinkedinIcon from "./LinkedinIcon.astro";
const { about } = Astro.props;
---

<div class="about center">
  <h1 class="title about__name">
    <span class="about__name-greeting">{about.greeting}</span>
    <span class="about__name-highlight">{about.name}</span>.
  </h1>

  <h2 class="about__role subtitle">
    {about.role}
  </h2>
  <p class="about__desc">
    {about.description}
  </p>

  <div class="about__actions">
    <a class="about__action about__action--primary" href="#projects">
      {about.projectsCta}
    </a>
    <a class="about__action" href="mailto:contact@thomasevano.fr">
      {about.contactCta}
    </a>
  </div>

  <div class="about__contact center">
    <a
      href={about.resumeLink}
      aria-label="resume"
      class="link link--icon"
      target="_blank"
    >
      <FileText />
    </a>

    <a
      href={about.github}
      aria-label="github"
      class="link link--icon"
      target="_blank"
    >
      <GithubIcon />
    </a>

    <a
      href={about.linkedin}
      aria-label="linkedin"
      class="link link--icon"
      target="_blank"
    >
      <LinkedinIcon />
    </a>

    <a
      href={about.twitter}
      aria-label="twitter"
      class="link link--icon"
      target="_blank"
    >
      <p class="x-logo">&Xopf;</p>
    </a>
    <a
      href={about.bluesky}
      aria-label="bluesky"
      class="link link--icon"
      target="_blank"
    >
      <BlueSkyIcon />
    </a>
  </div>
</div>

<script>
  import { animate, utils } from "animejs";

  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function formatTextToAnimate(text: HTMLHeadingElement) {
    if (text.dataset.staggered) return;
    text.dataset.staggered = "true";
    text.innerHTML = (text.textContent ?? "").replace(
      // eslint-disable-next-line no-control-regex
      /([^\x00-\x80]|\w|\W)/g,
      "<span class='letter'>$&</span>"
    );
  }

  document.addEventListener("astro:page-load", () => {
    if (prefersReducedMotion()) return;

    const greeting = document.querySelector<HTMLHeadingElement>(".about__name-greeting");
    const highlight = document.querySelector<HTMLHeadingElement>(".about__name-highlight");
    const subtitle = document.querySelector<HTMLHeadingElement>(".about__role");

    if (greeting) formatTextToAnimate(greeting);
    if (highlight) formatTextToAnimate(highlight);
    if (subtitle) formatTextToAnimate(subtitle);

    utils.set(".about .letter", { opacity: 0 });

    animate(".about .letter", {
      opacity: [0, 1],
      duration: 950,
      ease: "outExpo",
      delay: (_el, i) => 34 * ((i ?? 0) + 1),
    });
  });
</script>


<style>
  .about {
    flex-direction: column;
    margin-top: 3em;
  }


  .about__role {
    margin-top: 1.2em;
  }

  .about__name-highlight :global(.letter) {
    color: var(--clr-primary);
  }

  .about__desc {
    font-size: 1rem;
    max-width: 600px;
  }

  .about__desc,
  .about__contact {
    margin-top: 2.4em;
  }

  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 2rem;
  }

  .about__action {
    border: 1px solid var(--clr-primary);
    border-radius: 0.25rem;
    color: var(--clr-primary);
    font-weight: 500;
    padding: 0.65rem 1rem;
  }

  .about__action--primary {
    background: var(--clr-primary);
    color: var(--clr-bg);
  }

  .about .link--icon {
    margin-right: 0.8em;
  }

  .x-logo {
    font-size: 1.5rem;
    margin-top: -0.375rem;
  }

  @media (max-width: 600px) {
    .app .about {
      align-items: flex-start;
      margin-top: 2em;
    }
    .about__contact {
      margin: 2.4em auto;
    }
  }
</style>
