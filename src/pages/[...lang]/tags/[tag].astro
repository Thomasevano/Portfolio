---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogPost from "../../../components/BlogPost.astro";
import { langParam, locales, localizePath, useTranslations } from "../../../i18n/utils";
import { getPublishedPosts, postSlug } from "../../../lib/posts";

export async function getStaticPaths() {
  const postsByLang = await Promise.all(
    locales.map(async (lang) => [lang, await getPublishedPosts(lang)] as const)
  );

  return postsByLang.flatMap(([lang, langPosts]) => {
    const tags = [...new Set(langPosts.flatMap((post) => post.data.tags))];

    return tags.map((tag) => ({
      params: { lang: langParam(lang), tag },
      props: {
        lang,
        posts: langPosts.filter((post) => post.data.tags.includes(tag)),
      },
    }));
  });
}

const { tag } = Astro.params;
const { lang, posts } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout pageTitle={tag}>
  <section class="posts">
    <h1 class="posts__title">{t("tags.title")}{tag}</h1>
    <ul class="posts__grid">
      {
        posts.map((post) => (
          <BlogPost
            url={localizePath(`/posts/${postSlug(post)}/`, lang)}
            post={post}
          />
        ))
      }
    </ul>
  </section>
</BaseLayout>
