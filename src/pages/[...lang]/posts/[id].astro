---
import { getCollection, render } from "astro:content";
import MarkdownPostLayout from "../../../layouts/MarkdownPostLayout.astro";
import { langParam, type Lang } from "../../../i18n/utils";
import { isPublished } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("blogPosts", isPublished);

  return posts.map((post) => {
    const [lang, ...id] = post.id.split("/");
    return {
      params: { lang: langParam(lang as Lang), id: id.join("/") },
      props: { post, lang: lang as Lang },
    };
  });
}

const { post, lang } = Astro.props;
const { id } = Astro.params;
const { Content, remarkPluginFrontmatter } = await render(post);
---

<MarkdownPostLayout
  frontmatter={post.data}
  lang={lang}
  minutesRead={remarkPluginFrontmatter.minutesRead}
  slug={id}
>
  <Content />
</MarkdownPostLayout>
