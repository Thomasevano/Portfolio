---
import About from "../../components/About.astro";
import Skills from "../../components/Skills.astro";
import Projects from "../../components/Projects.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { localeRoutes, useTranslations } from "../../i18n/utils";
import { getPinnedRepos } from "../../lib/pinnedRepos";

export const getStaticPaths = localeRoutes;

const { lang } = Astro.props;
const t = useTranslations(lang);

const [aboutMeInfos] = await getCollection("aboutMe");
const projects = await getPinnedRepos("Thomasevano");

const aboutMeData = {
  ...aboutMeInfos.data,
  description: t("aboutMe.description"),
  resumeLink: t("aboutMe.resume-link"),
};
---

<BaseLayout
  pageTitle={`${aboutMeData.name} - ${aboutMeData.role}`}
  description={aboutMeData.description}
>
  <About about={aboutMeData} />
  <Projects projects={projects} />
  <Skills skills={aboutMeData.skills} />
</BaseLayout>
